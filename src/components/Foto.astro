---
const { img, alt = '', pos = '50% 50%', sizes = '(max-width: 760px) 72vw, 340px', loading = 'lazy', clase = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<img
  class={clase}
  src={`${base}img/${img}-960.webp`}
  srcset={`${base}img/${img}-480.webp 480w, ${base}img/${img}-960.webp 960w`}
  sizes={sizes}
  alt={alt}
  loading={loading}
  decoding="async"
  style={`object-position:${pos}`}
/>
